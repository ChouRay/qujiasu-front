# 1. 依赖目录 (核心，必须忽略)
node_modules/

# 2. 构建输出目录 (核心，必须忽略)
/dist
/build
/dist2
/dist3
/output/

# 3. 本地环境配置文件 (包含敏感信息，如API密钥)
.env.local
.env.*.local

# 4. 日志文件
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 5. 操作系统生成的文件
.DS_Store
Thumbs.db

# 6. 编辑器或IDE配置 (保持团队编辑器差异独立)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*~

# 7. 其他常见临时或依赖文件
package-lock.json
yarn.lock
pnpm-lock.yaml  # 如果使用 pnpm，也建议忽略锁文件[citation:11]
*.zip
*.tar.gz
*.rar
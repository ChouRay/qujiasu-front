```gitignore
# Vue.js build artifacts
dist/
build/
*.vuepress/dist/

# Dependencies
node_modules/

# Logs and temp files
*.log
*.tmp

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Python artifacts (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd

# Build outputs
target/
*.out
*.exe
*.dll
*.so
*.a

# Compression files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst

# OS specific
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
*.coverage

# Cache directories
.cache/
.mypy_cache/
.pytest_cache/
.gradle/
```